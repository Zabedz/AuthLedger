# Copy to .env and adjust as needed. Every variable the app or compose reads
# is listed here; .env itself is git-ignored and must never be committed.

# development | test | production
NODE_ENV=development

# API listen port. The web dev server proxies /api to this port.
PORT=8000

# pino level: trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# Browser origin of the SPA, checked against the Origin header on every
# state-changing request (CSRF defense). Required in production; in dev it
# defaults to the vite dev server below.
APP_ORIGIN=http://localhost:5173

# Matches the postgres service in compose.yaml. Local-only credentials.
DATABASE_URL=postgres://authledger:authledger@localhost:5432/authledger

# SMTP transport. Dev points at the compose Mailpit service (no auth). In
# production these hold the SES SMTP endpoint and IAM SMTP credentials.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=authledger <no-reply@authledger.test>

# 32-byte AES key (base64) that encrypts TOTP secrets at rest. Required in
# production; dev and CI fall back to a fixed key when unset. Generate one with
# `head -c 32 /dev/urandom | base64`.
ENCRYPTION_KEY=

# SNS topic ARN that SES delivery events (bounce/complaint) publish to. When
# set, the webhook rejects messages from any other topic. Prod-only; unset in
# dev and CI, where the topic does not exist.
SES_SNS_TOPIC_ARN=

# Stripe sandbox secret key. Unset until the payments milestone; when set
# outside production it must start with sk_test_ or the app refuses to boot.
# Also consumed by the stripe-cli compose service (profile: stripe).
STRIPE_SECRET_KEY=

# Tracing. Off unless an exporter is set. OTEL_TRACES_CONSOLE=true prints spans
# to stdout for local inspection; OTEL_EXPORTER_OTLP_ENDPOINT points at an
# OTLP/HTTP collector (the exporter also reads OTEL_EXPORTER_OTLP_HEADERS).
OTEL_TRACES_CONSOLE=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Sentry error tracking DSN. Error reporting is off when unset. The region is
# read from the DSN.
SENTRY_DSN=
