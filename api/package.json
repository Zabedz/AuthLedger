{
  "name": "@authledger/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "migrate:create": "node-pg-migrate create -j sql",
    "codegen": "kysely-codegen --dialect postgres --exclude-pattern \"pgboss.*\" --out-file src/db/types.ts",
    "seed": "tsx --env-file=../.env src/seed.ts"
  },
  "dependencies": {
    "@authledger/shared": "*",
    "@fastify/cookie": "^11.1.1",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/swagger": "^9.8.0",
    "@fastify/swagger-ui": "^6.1.0",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@sinclair/typebox": "^0.34.52",
    "argon2": "^0.44.0",
    "fastify": "^5.10.0",
    "kysely": "^0.29.3",
    "node-pg-migrate": "^8.0.4",
    "nodemailer": "^9.0.3",
    "openid-client": "^6.8.4",
    "otplib": "^13.4.1",
    "pg": "^8.22.0",
    "pg-boss": "^12.26.0",
    "stripe": "^22.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "kysely-codegen": "^0.20.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.1",
    "vitest": "^4.1.10"
  }
}
