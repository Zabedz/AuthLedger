{
  "name": "@authledger/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "migrate:create": "node-pg-migrate create -j sql",
    "codegen": "kysely-codegen --dialect postgres --exclude-pattern \"pgboss.*\" --out-file src/db/types.ts",
    "openapi:gen": "tsx src/openapi-gen.ts",
    "job:reconcile": "tsx --env-file=../.env src/jobs/reconcile.ts",
    "seed": "tsx --env-file=../.env src/seed.ts"
  },
  "dependencies": {
    "@authledger/shared": "*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.0",
    "@fastify/swagger-ui": "^6.1.0",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@sentry/node": "^10.69.0",
    "@sinclair/typebox": "^0.34.52",
    "argon2": "^0.45.1",
    "fastify": "^5.11.2",
    "kysely": "^0.29.4",
    "node-pg-migrate": "^8.0.4",
    "nodemailer": "^9.0.4",
    "openid-client": "^6.8.4",
    "otplib": "^13.4.1",
    "pg": "^8.22.0",
    "pg-boss": "^12.27.0",
    "pino": "^10.3.1",
    "stripe": "^22.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.4",
    "jose": "^6.2.8",
    "kysely-codegen": "^0.20.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.9",
    "vitest": "^4.1.10"
  }
}
